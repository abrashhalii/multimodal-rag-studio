# ---------------------------------------------------------------- LLM
# "gemini" for quality, "ollama" for a fully offline fallback.
LLM_PROVIDER=gemini

GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

OLLAMA_MODEL=llama3.2
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# free-tier ceiling for your model - check console.cloud / AI Studio
LLM_RPM=15
# stay under the cap - provider windows are not aligned with ours
RATE_LIMIT_SAFETY=0.7

# ---------------------------------------------------------------- summaries
SUMMARY_CHAPTER_WORDS=220
SUMMARY_BOOK_WORDS=500
SUMMARY_MAX_CHAPTER_CHARS=60000
# keep false: build explicitly with tools/build_summaries.py so uploads stay fast
# and a failed build never blocks an upload
BUILD_SUMMARIES_ON_INGEST=false

# ---------------------------------------------------------------- vision (comics)
VISION_BATCH_PAGES=4
VISION_IMAGE_MAX_EDGE=1400
VISION_JPEG_QUALITY=80
# ltr for Western comics, rtl for Japanese manga
COMIC_READING_ORDER=ltr
# cast list for speaker attribution - leave blank if unknown
COMIC_CHARACTERS=Magneto, Rogue, Sabretooth, Blink, Sunfire, Storm, Cyclops, Havok, Apocalypse, Nightcrawler, Bishop, Jean Grey, Weapon X, Holocaust, Mister Sinister, Dark Beast, Colossus, Shadowcat, Gambit, Iceman, Quicksilver, Angel, Northstar, Aurora, Dazzler, Emma Frost, Banshee, Forge, Mystique, Destiny, Unus, Domino, Silver Samurai, Callisto, Caliban, Morph, Exodus, Sauron, Wild Child, Prelate
# sound effects are stored but kept out of semantic retrieval
INDEX_SFX=false

# ---------------------------------------------------------------- memory
HISTORY_TURNS=6
REWRITE_FOLLOWUPS=true

# ---------------------------------------------------------------- embeddings
# bge-small-en-v1.5 = 512-token window (MiniLM is only 256 and silently truncates)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------- chunking
CHUNK_CHARS=900
CHUNK_OVERLAP_LINES=2
PAGE_BOUNDED_CHUNKS=true

# ---------------------------------------------------------------- extraction
HEADER_ZONE=0.08
FOOTER_ZONE=0.92
MIN_FOLIO_AGREEMENT=0.30
MAX_PAGES=0

# ---------------------------------------------------------------- retrieval
RETRIEVAL_K=12
# fuse BM25 with dense retrieval (reciprocal rank fusion)
HYBRID_RETRIEVAL=true
CANDIDATE_K=40
GLOBAL_K=120

# ---------------------------------------------------------------- storage
DB_DIR=chroma_db
INDEX_DIR=page_index
TEMP_DIR=temp
CACHE_DIR=cache

# ---------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8000
DEBUG_LOG=true
