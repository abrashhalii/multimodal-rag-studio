# ---------------------------------------------------------------- LLM
# "gemini" for quality, "ollama" for a fully offline fallback.
LLM_PROVIDER=gemini

GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

OLLAMA_MODEL=llama3.2
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------- embeddings
# bge-small-en-v1.5 = 512-token window (MiniLM is only 256 and silently truncates)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------- chunking
CHUNK_CHARS=900
CHUNK_OVERLAP_LINES=2
PAGE_BOUNDED_CHUNKS=true

# ---------------------------------------------------------------- extraction
HEADER_ZONE=0.08
FOOTER_ZONE=0.92
MIN_FOLIO_AGREEMENT=0.30
MAX_PAGES=0

# ---------------------------------------------------------------- retrieval
RETRIEVAL_K=12
CANDIDATE_K=40
GLOBAL_K=120

# ---------------------------------------------------------------- storage
DB_DIR=chroma_db
INDEX_DIR=page_index
TEMP_DIR=temp
CACHE_DIR=cache

# ---------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8000
DEBUG_LOG=true
